# Public site URL — used for metadata, Open Graph, sitemap, and Paystack callback URLs.
# Set this to your real domain once deployed (e.g. https://beltoftruth.org).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Sanity CMS ──────────────────────────────────────────────────────────
# Create a free project at https://www.sanity.io/manage → copy the Project ID.
# Without these, the site still works and falls back to the static content
# in lib/site-config.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity API token with "Editor" permissions — needed only so the Paystack
# webhook can write donation records. Create one at
# https://www.sanity.io/manage → your project → API → Tokens.
SANITY_API_TOKEN=

# ─── Resend (contact form emails) ───────────────────────────────────────
# Create a free account at https://resend.com, verify a sending domain (or
# use their onboarding@resend.dev sandbox address while testing), then
# create an API key.
RESEND_API_KEY=
# Where contact form submissions should be delivered.
CONTACT_INBOX_EMAIL=
# Must be a verified sender/domain in Resend once you leave sandbox mode.
CONTACT_FROM_EMAIL="Belt of Truth Website <onboarding@resend.dev>"

# ─── Paystack (donations + book purchases) ──────────────────────────────
# Create a free account at https://paystack.com, switch on Kenya/KES and
# M-Pesa in your dashboard, then grab your keys under Settings → API Keys.
# Use the sk_test_ key while developing (checkout uses Paystack's hosted
# redirect flow, so only the secret key is needed — no public key required).
PAYSTACK_SECRET_KEY=

# ─── M-Pesa Till (Buy Goods) via Safaricom Daraja — optional, in-progress ──
# A second, direct payment option alongside Paystack's own M-Pesa channel.
# Get sandbox credentials by creating an app at
# https://developer.safaricom.co.ke (Daraja) — pick the "Lipa Na M-Pesa
# Online" (STK Push) product, which gives you a test Till/shortcode +
# passkey. Leave MPESA_ENV unset (or "sandbox") until you have real
# production credentials from Safaricom for your actual till number.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
# Real Till numbers use "CustomerBuyGoodsOnline" (the default, so you can
# leave this unset in production). Safaricom's public sandbox test
# shortcode (174379) is provisioned as a PayBill on their end, though, and
# rejects that with "Invalid TransactionType" — set this to
# CustomerPayBillOnline only while testing against that specific shortcode.
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# Daraja needs a public HTTPS callback URL, so this only works once
# deployed (or via a tunnel like ngrok locally) — set to
# https://<your-domain>/api/mpesa/callback in the Daraja app config.
#
# This whole option is HIDDEN from the live checkout forms until you set
# this to "true" — leave it unset in production until you're ready to
# launch it, even after the credentials above are filled in.
NEXT_PUBLIC_MPESA_TILL_ENABLED=false

# ─── Protected ebook reader ──────────────────────────────────────────────
# Signs the reader's access-session cookie after a buyer redeems their
# emailed link. Generate with: openssl rand -base64 32
# Required for any book that has an ebook file attached in Sanity Studio.
EBOOK_SESSION_SECRET=

# ─── Admin dashboard (/admin) ────────────────────────────────────────────
# A single shared password protecting /admin — pick something strong, this
# guards contact-form submissions, donor emails, and payment references.
ADMIN_PASSWORD=
# Signs the admin login cookie. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
