# Public site URL — used for metadata, Open Graph, sitemap, and Paystack callback URLs.
# Set this to your real domain once deployed (e.g. https://beltoftruth.org).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Sanity CMS ──────────────────────────────────────────────────────────
# Create a free project at https://www.sanity.io/manage → copy the Project ID.
# Without these, the site still works and falls back to the static content
# in lib/site-config.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity API token with "Editor" permissions — needed only so the Paystack
# webhook can write donation records. Create one at
# https://www.sanity.io/manage → your project → API → Tokens.
SANITY_API_TOKEN=

# ─── Resend (contact form emails) ───────────────────────────────────────
# Create a free account at https://resend.com, verify a sending domain (or
# use their onboarding@resend.dev sandbox address while testing), then
# create an API key.
RESEND_API_KEY=
# Where contact form submissions should be delivered.
CONTACT_INBOX_EMAIL=
# Must be a verified sender/domain in Resend once you leave sandbox mode.
CONTACT_FROM_EMAIL="Belt of Truth Website <onboarding@resend.dev>"

# ─── Paystack (donations + book purchases) ──────────────────────────────
# Create a free account at https://paystack.com, switch on Kenya/KES and
# M-Pesa in your dashboard, then grab your keys under Settings → API Keys.
# Use the sk_test_ key while developing (checkout uses Paystack's hosted
# redirect flow, so only the secret key is needed — no public key required).
PAYSTACK_SECRET_KEY=

# ─── Protected ebook reader ──────────────────────────────────────────────
# Signs the reader's access-session cookie after a buyer redeems their
# emailed link. Generate with: openssl rand -base64 32
# Required for any book that has an ebook file attached in Sanity Studio.
EBOOK_SESSION_SECRET=
